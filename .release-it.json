{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:git:init": [
      "node scripts/release-tools.mjs guard-source",
      "git config user.name || git config user.name \"github-actions[bot]\"",
      "git config user.email || git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\""
    ],
    "after:git:release": "node scripts/release-tools.mjs publish ${version} release"
  },
  "git": {
    "requireBranch": ["main", "master"],
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "requireCommits": false,
    "commit": true,
    "commitMessage": "chore(release): ${version} [skip ci]",
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "v${version}",
    "tagMatch": "v[0-9]*.[0-9]*.[0-9]*",
    "push": true,
    "pushArgs": ["--follow-tags", "--atomic"]
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "conventionalcommits",
      "infile": "CHANGELOG.md",
      "ignoreRecommendedBump": true
    }
  }
}
